# EduSport frontend environment. Copy to .env.local for dev or .env.production for the prod stack.
# An empty value counts as missing everywhere a default exists.

# ----- Required: public origins (build args, inlined into the bundle) -----
# Public site origin for sitemap, robots, OpenGraph and JsonLd. REQUIRED in production: the build fails without it.
# Example: https://www.scoaladepatinaj.ro
NEXT_PUBLIC_SITE_URL=
# Public Strapi origin, reachable from the browser (form posts, uploads). next/image derives its allowed uploads host from it.
# Example: https://cms.scoaladepatinaj.ro   Local dev default: http://localhost:1337
NEXT_PUBLIC_STRAPI_URL=

# ----- Strapi access (server side, read at runtime) -----
# Read-only Strapi API token (Settings > API Tokens).
STRAPI_API_TOKEN=
# Optional: internal Strapi address for server rendering, e.g. http://edusport_backend:1337 (falls back to NEXT_PUBLIC_STRAPI_URL).
# STRAPI_INTERNAL_URL=

# ----- Cache purge and preview (shared secrets with Strapi) -----
# Strapi sends `x-revalidate-secret: <this value>` to /api/revalidate.
REVALIDATE_SECRET=
# /api/preview checks `?secret=` against this; must equal STRAPI_PREVIEW_SECRET on the Strapi side.
STRAPI_PREVIEW_SECRET=

# ----- Analytics (Umami, optional) -----
# Analytics is ON only when BOTH the website id and the script URL are set; there is no Umami Cloud fallback.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_URL=https://analytics.example.com/script.js
# One Umami website per portal host (build time, public). Unset: no script on that portal. Uses NEXT_PUBLIC_UMAMI_URL.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID_SPORTIV=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID_ANTRENOR=

# ----- Error tracking (GlitchTip, Sentry-API compatible, optional) -----
# One set of NEXT_PUBLIC_ values serves browser, server and edge (build time). No DSN: Sentry.init is skipped, nothing is captured.
# Release defaults to NEXT_PUBLIC_COMMIT_SHA, environment to NODE_ENV.
# NEXT_PUBLIC_SENTRY_DSN=https://<publicKey>@glitchtip.example.com/<projectId>
# NEXT_PUBLIC_SENTRY_RELEASE=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional: Sentry SaaS source-map upload during build (not needed for GlitchTip).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ----- Build and deploy info -----
# Optional: bundle analyzer (`ANALYZE=true npm run build`).
# ANALYZE=
# Short git SHA of the deployment; scripts/deploy.sh injects it at build time and /api/health echoes it.
NEXT_PUBLIC_COMMIT_SHA=

# ----- Portals (coach and athlete/parent apps, optional, server side, read at runtime) -----
# Off unless the host names below are set (unset: the portal routes answer 404 on every host). The backend has its own switch, PORTAL_HOSTS.
# Shared secret with Strapi (PORTAL_BFF_SECRET there), at least 32 characters. Rotate on both sides together.
# PORTAL_BFF_SECRET=
# Strapi base URL for the portal server calls (falls back to the Strapi base URL).
# PORTAL_STRAPI_URL=
# Portal hostnames, no protocol, no port. They route a host to its pages and build the Google redirect URI
# https://<host>/api/portal/google/callback (register that exact URI in Google). Same hosts as PORTAL_ANTRENOR_URL / PORTAL_SPORTIV_URL on the backend.
# PORTAL_HOST_ANTRENOR=antrenor.example.ro
# PORTAL_HOST_SPORTIV=sportiv.example.ro

# ----- Staff guide -----
# Password for the guide at /ghid (site host only). Missing or empty: the guide refuses every password.
GHID_PASSWORD=

# ----- Other optional -----
# skate-results API base (default https://skate-api.codrin.space).
# SKATE_RESULTS_API=
