# Public site URL (used by sitemap, robots, OpenGraph, JsonLd).
# Example: https://www.scoaladepatinaj.ro
NEXT_PUBLIC_SITE_URL=

# Strapi base URL — must be reachable from the Next server AND from clients
# (next/image fetches uploads from here). Example:
#   https://cms.scoaladepatinaj.ro
# Local dev default: http://localhost:1337
NEXT_PUBLIC_STRAPI_URL=

# Hostname (no protocol/port) used by next.config.ts to allow next/image to
# fetch from Strapi uploads. Example: cms.scoaladepatinaj.ro
NEXT_PUBLIC_STRAPI_IMAGE_HOST=

# Read-only Strapi API token (Settings → API Tokens). Server-side only.
STRAPI_API_TOKEN=

# Shared secret with the Strapi `Webhooks` entry that calls
# /api/revalidate. Strapi must send `x-revalidate-secret: <this value>`.
REVALIDATE_SECRET=

# Shared secret with the Strapi admin Preview handler (config/admin.ts ->
# preview.config.handler). The /api/preview route validates `?secret=...`
# against this value before enabling Next.js draftMode. Must match the
# `STRAPI_PREVIEW_SECRET` env var configured on the Strapi side.
STRAPI_PREVIEW_SECRET=

# Optional analytics
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_URL=https://analytics.umami.is/script.js

# Optional error tracking (self-hosted GlitchTip, Sentry-API compatible).
# Leave BOTH blank to disable: with no DSN, Sentry.init is skipped and the SDK
# is a no-op (nothing is captured, builds and runtime are unaffected).
# Both values are the SAME GlitchTip project DSN, e.g.
#   https://<publicKey>@glitchtip.example.com/<projectId>
# Client/browser DSN (inlined into the client bundle at build time):
# NEXT_PUBLIC_SENTRY_DSN=
# Server/edge DSN (read at runtime; falls back to NEXT_PUBLIC_SENTRY_DSN):
# SENTRY_DSN=
#
# Optional: Sentry SaaS source-map upload during build. Not needed for
# GlitchTip. Source maps upload only when SENTRY_AUTH_TOKEN is set.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Optional: enable bundle analyzer (`ANALYZE=true npm run build`)
# ANALYZE=

# Short git SHA of the current deployment. scripts/deploy.sh injects this at
# build time; /api/health echoes it back so the proxy/ops can confirm which
# revision is live.
NEXT_PUBLIC_COMMIT_SHA=
